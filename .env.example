# ============================================================
# AI Module — Environment Variables
# Copy this file to AI/.env and fill in your values.
# Owned by: AI Team + ML Team
# ============================================================

# ----- Inference Backend -----
# Which segmentation backend to use.
# Options:
#   rembg  — no model file needed; downloads weights automatically (recommended default)
#   onnx   — fastest CPU/GPU inference; requires ONNX_MODEL_PATH to point to a .onnx file
#   torch  — load PyTorch weights directly; requires TORCH_MODEL_PATH to point to a .pth file
MODEL_BACKEND=rembg

# ----- Quality Tier (rembg backend only) -----
# Per-request quality default. Individual requests can override this.
#   fast     — isnet-general-use    (~1-2 s, great for products and objects)
#   standard — u2net_human_seg      (~2-3 s, portrait-tuned, best for people/faces)
#   quality  — birefnet-general     (~4-6 s, best edge quality for hair, fur, complex subjects)
DEFAULT_QUALITY=fast

# ----- Model Weight Paths (onnx / torch backends only) -----
# Only used when MODEL_BACKEND=onnx or MODEL_BACKEND=torch.
# Place your model files in AI/models/ (the directory is gitignored except for .gitkeep).
ONNX_MODEL_PATH=models/model.onnx
TORCH_MODEL_PATH=models/model.pth

# ----- Input Resolution -----
# Model input size in pixels (square). U²-Net / BiRefNet / RMBG-2.0 expect 1024.
# Only change this if you are using a custom model with a different input size.
MODEL_INPUT_SIZE=1024
